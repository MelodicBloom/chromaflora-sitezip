{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromaflora.dev/schemas/mandala-engine.schema.json",
  "title": "ChromaFlora Mandala Engine Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "engine", "render", "style", "animation", "worker", "glsl", "three"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rings", "steps", "complexity", "seed", "formula", "symmetry", "layers"],
      "properties": {
        "mode": { "type": "string", "enum": ["cpu-worker", "three-shader-hybrid"], "default": "cpu-worker" },
        "rings": { "type": "integer", "minimum": 1, "maximum": 64, "default": 12 },
        "steps": { "type": "integer", "minimum": 16, "maximum": 4096, "default": 720 },
        "complexity": { "type": "number", "minimum": 0, "maximum": 4, "default": 1.0 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647, "default": 1337 },
        "formula": { "type": "string", "enum": ["polar", "rose", "spirograph", "lissajous", "sacred", "toroid"], "default": "polar" },
        "symmetry": { "type": "integer", "minimum": 1, "maximum": 24, "default": 8 },
        "layers": { "type": "integer", "minimum": 1, "maximum": 12, "default": 4 },
        "radius": { "type": "number", "minimum": 20, "maximum": 100, "default": 85 },
        "freq": { "type": "number", "minimum": 0.5, "maximum": 20, "default": 3 },
        "amp": { "type": "number", "minimum": 0, "maximum": 160, "default": 40 },
        "phase": { "type": "number", "minimum": 0, "maximum": 6.283185307179586, "default": 0 },
        "harm": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "mirror": { "type": "boolean", "default": true },
        "golden": { "type": "boolean", "default": false },
        "noiseAmp": { "type": "number", "minimum": 0, "maximum": 80, "default": 0 },
        "noiseScale": { "type": "number", "minimum": 0.002, "maximum": 0.2, "default": 0.02 },
        "noiseOctaves": { "type": "integer", "minimum": 1, "maximum": 8, "default": 3 }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dprMode", "maxDprMobile", "maxDprDesktop", "touchAction", "safeAreaInsets"],
      "properties": {
        "dprMode": { "type": "string", "enum": ["auto", "fixed"], "default": "auto" },
        "fixedDpr": { "type": "number", "minimum": 0.5, "maximum": 4 },
        "maxDprMobile": { "type": "number", "minimum": 1, "maximum": 3, "default": 2 },
        "maxDprDesktop": { "type": "number", "minimum": 1, "maximum": 4, "default": 2.5 },
        "touchAction": { "type": "string", "enum": ["none", "manipulation"], "default": "none" },
        "safeAreaInsets": { "type": "boolean", "default": true },
        "targetFps": { "type": "integer", "minimum": 24, "maximum": 120, "default": 60 },
        "adaptiveQuality": { "type": "boolean", "default": true }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colorMode", "palette", "opacity", "lineWeight", "glow", "glowAmt", "bg"],
      "properties": {
        "colorMode": { "type": "string", "enum": ["palette", "rainbow", "gradient", "mono"], "default": "palette" },
        "color": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$", "default": "#a855f7" },
        "palette": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$" }
        },
        "opacity": { "type": "number", "minimum": 0.05, "maximum": 1, "default": 0.8 },
        "lineWeight": { "type": "number", "minimum": 0.2, "maximum": 6, "default": 1.2 },
        "glow": { "type": "boolean", "default": true },
        "glowAmt": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "bg": { "type": "string", "enum": ["void", "radial", "dark", "white"], "default": "void" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "spin", "pulse", "noiseAnim"],
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "spin": { "type": "number", "minimum": -0.03, "maximum": 0.03, "default": 0 },
        "pulse": { "type": "number", "minimum": 0, "maximum": 3, "default": 0 },
        "noiseAnim": { "type": "boolean", "default": false },
        "trail": { "type": "boolean", "default": false }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "transferable", "batchSize", "maxStepsPerDispatch"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "transferable": { "type": "boolean", "default": true },
        "batchSize": { "type": "integer", "minimum": 128, "maximum": 131072, "default": 8192 },
        "maxStepsPerDispatch": { "type": "integer", "minimum": 60, "maximum": 720, "default": 180 }
      }
    },
    "glsl": { "type": "object" },
    "three": { "type": "object" }
  }
}
